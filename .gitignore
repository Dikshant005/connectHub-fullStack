# ==============================
# ConnectHub Root .gitignore
# ==============================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Build Outputs
dist/
dist-ssr/
build/
*/dist/
*/build/

# Uploads & Temp Files
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
logs/
*/logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
